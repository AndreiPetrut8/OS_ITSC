; boot.asm - 512-byte boot sector
; Loads kernel from sectors 2..N into 0x0000:0x8000, enters protected mode, jumps to 1MB

[org 0x7C00]
BITS 16

KERNEL_SECTORS   equ 16         ; Ajustează în funcție de mărimea kernelului (16 = 8 KB)
CODE_SELECTOR    equ 0x08
DATA_SELECTOR    equ 0x10

start:
    cli
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov sp, 0x7C00
    sti

    ; Load kernel sectors via BIOS
    mov ax, 0x0000
    mov es, ax
    mov bx, 0x8000

    mov ah, 0x02
    mov al, KERNEL_SECTORS
    mov ch, 0x00
    mov cl, 0x02
    mov dh, 0x00
    mov dl, 0x80
    int 0x13
    jc disk_error

    ; Setup GDT
    cli
    lgdt [gdt_descriptor]

    ; Enable A20 line
    in al, 0x92
    or al, 2
    out 0x92, al

    ; Enter Protected Mode
    mov eax, cr0
    or eax, 1
    mov cr0, eax

    jmp CODE_SELECTOR:pmode_main

disk_error:
    hlt

; ---- GDT ----
gdt_start:
    dq 0x0000000000000000
    dq 0x00CF9A000000FFFF  ; code segment
    dq 0x00CF92000000FFFF  ; data segment
gdt_end:

gdt_descriptor:
    dw gdt_end - gdt_start - 1
    dd gdt_start

; ---- Protected Mode ----
[BITS 32]
pmode_main:
    mov ax, DATA_SELECTOR
    mov ds, ax
    mov es, ax
    mov fs, ax
    mov gs, ax
    mov ss, ax

    mov esp, 0x90000

    ; Copy kernel from 0x8000 to 1MB
    mov esi, 0x00008000
    mov edi, 0x00100000
    mov ecx, (KERNEL_SECTORS * 512) / 4
    rep movsd

    ; Jump to kernel entry point (1MB)
    mov eax, 0x00100000
    jmp dword eax

times 510 - ($ - $$) db 0
dw 0xAA55	
