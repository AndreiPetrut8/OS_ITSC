#include "tss.h"
#include "gdt.h"

struct tss_entry {
    uint32_t prev_tss, esp0, ss0, esp1, ss1, esp2, ss2;
    uint32_t cr3, eip, eflags, eax, ecx, edx, ebx, esp, ebp, esi, edi;
    uint32_t es, cs, ss, ds, fs, gs, ldt, iomap_base;
} __attribute__((packed));

static struct tss_entry tss;

void tss_init(uint32_t kernel_stack_top) {
    for (uint32_t i = 0; i < sizeof(tss); i++)
        ((uint8_t*)&tss)[i] = 0;

    tss.ss0  = 0x10;          /* kernel data segment */
    tss.esp0 = kernel_stack_top;
    tss.iomap_base = sizeof(tss);
}

void tss_set_esp0(uint32_t stack) {
    tss.esp0 = stack;
}

void tss_install_gdt(void) {
    uint32_t base  = (uint32_t)&tss;
    uint32_t limit = sizeof(tss) - 1;
    gdt_set_gate(5, base, limit, 0x89, 0x40);

    extern void tss_load(void);
    tss_load();
}
